{
	"extends": ["./node_modules/@f0rbit/oxlint-config/oxlintrc.json"],
	"ignorePatterns": ["**/node_modules/**", "**/dist/**", "**/coverage/**", ".claude/**"],
	"overrides": [
		{
			"files": ["src/components/**/*.astro", "src/components/**/*.tsx", "src/layouts/**/*.astro"],
			"rules": {
				"unicorn/filename-case": "off"
			}
		},
		{
			"files": ["src/pages/**/*.astro", "src/pages/**/*.ts"],
			"rules": {
				"unicorn/filename-case": "off"
			}
		},
		{
			"files": ["src/env.d.ts"],
			"rules": {
				"typescript/triple-slash-reference": "off"
			}
		},
		{
			"files": ["src/layouts/Page.astro"],
			"rules": {
				"import/no-unassigned-import": "off"
			}
		},
		{
			"files": ["src/layouts/Page.astro", "src/lib/pulse.ts"],
			"rules": {
				"no-underscore-dangle": ["error", { "allow": ["__PULSE_CONFIG__"] }]
			}
		}
	]
}

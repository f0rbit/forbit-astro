---
import Home from "../layouts/Home.astro";
import PromptLine from "../components/PromptLine.astro";
import Experience from "../components/about/Experience.astro";
import Timeline from "../components/activity/Timeline.astro";
import ProjectList from "../components/projects/ProjectList.astro";
import RecentBlogs from "../components/blog/RecentBlogs.astro";
import { Typewriter } from "solidjs-typewriter";
import { MapPin, Briefcase, CircleDot } from "lucide-astro";

export const prerender = false;
---

<Home>
	<main class="page-container home-sections">
		<header class="hero stack">
			<PromptLine path="~" cmd="whoami" />
			<h1 class="hero-name">Tom Materne <span class="text-muted">/ forbit</span></h1>
			<p class="hero-tagline">
				Software engineer. I build <span class="accent-blue">developer tools</span>, <span class="accent-green"
					>games</span
				> & <span class="accent-purple">the web</span>.
			</p>
			<p class="hero-role text-muted text-sm font-mono">
				$ cat role.txt &#8594;{" "}
				<span class="hero-role-word">
					{/* above-fold hero animation — always in the initial viewport, so
					client:idle hydrates as soon as the main thread is free instead of
					paying for an IntersectionObserver that would fire immediately anyway */}
					<Typewriter
						client:idle
						words={[
							"computer science student",
							"software developer",
							"open source contributor",
							"programming enthusiast",
						]}
						cursor={false}
						loop={-1}
					/>
				</span>
				<span class="cursor" aria-hidden="true"></span>
			</p>
			<div class="hero-chips row row-sm">
				<span class="chip"><MapPin size={14} />Brisbane, AU</span>
				<span class="chip"><Briefcase size={14} />SDE @ Amazon</span>
				<span class="chip chip--accent"><CircleDot size={14} />available for chat</span>
			</div>
		</header>

		<section id="projects" class="stack">
			<PromptLine path="~/work" cmd="ls --featured" />
			<div class="featured-list">
				<ProjectList select={["devpad", "gm-server", "runbook", "dungeon-generator"]} />
			</div>
		</section>

		<div class="recent-columns">
			<section id="recent-activity" class="stack">
				<PromptLine path="~" cmd="git log --oneline" />
				<Timeline limit={10} group_commits={false} />
			</section>
			<section id="experience" class="stack">
				<PromptLine path="~" cmd="cat experience.log" />
				<Experience types={["professional"]} sort={"reverse_position"} mode={"left"} />
			</section>
		</div>

		<section id="recent-blogs" class="stack">
			<PromptLine path="~/blog" cmd="ls -lt --posts | head -3" />
			<RecentBlogs />
		</section>
	</main>
</Home>

<style>
	.home-sections {
		display: flex;
		flex-direction: column;
		gap: var(--space-xl);
		padding-block: var(--space-lg);
	}

	.hero-name {
		font-size: var(--text-4xl);
		font-weight: 700;
		letter-spacing: -0.02em;
		margin: 0;
	}

	.hero-tagline {
		font-size: var(--text-lg);
		color: var(--fg-muted);
		margin: 0;
	}

	.hero-role {
		margin: 0;
	}

	.hero-role-word {
		color: var(--fg);
	}

	.accent-blue {
		color: var(--term-link);
	}
	.accent-green {
		color: var(--term-prompt-user);
	}
	.accent-purple {
		color: var(--term-keyword);
	}

	.hero-chips {
		margin-top: var(--space-xs);
		flex-wrap: wrap;
	}

	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		font-size: var(--text-sm);
		font-family: var(--font-mono);
		border: 1px solid var(--term-border-inner);
		border-radius: var(--radius);
		padding: 0.35em 0.7em;
		color: var(--fg-muted);
	}

	.chip--accent {
		border-color: var(--term-link);
		color: var(--term-link);
	}

	.featured-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
	}

	.recent-columns {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-lg);
	}

	.recent-columns > section {
		min-width: 0;
	}

	/*
	 * Home-only: unify the two `.recent-columns` rails (`git log --oneline`
	 * vs `cat experience.log`) into one visual system — same dot size/color,
	 * same meta-line size/color/placement, same headline size/weight/color,
	 * same secondary-text size, same vertical rhythm, same rail offset.
	 * Timeline/CommitList and Experience/ExperienceCard are shared with
	 * /timeline and /about (where their original, fuller scale is correct),
	 * so every rule below is scoped under .recent-columns rather than
	 * changed on the components themselves. See AGENTS.md for the full spec.
	 */

	/* dot: 10px solid, single shared color, no ring, same 20px rail offset */
	.recent-columns :global(.activity-dot) {
		width: 10px;
		height: 10px;
		left: calc(-1.25rem - 5px);
		top: 0.35rem;
		border: none;
		background: var(--term-gray-58);
	}

	.recent-columns :global(.experience-indicator) {
		width: 2.5rem;
	}

	.recent-columns :global(.experience-row) {
		gap: 0;
	}

	.recent-columns :global(.experience-dot) {
		width: 10px;
		height: 10px;
		background: var(--term-gray-58);
	}

	/* meta line: date/time onto its own line, top of entry, same size/color */
	.recent-columns :global(.activity-content) {
		flex-direction: column;
		align-items: flex-start;
		gap: 0.15rem;
	}

	.recent-columns :global(.activity-time),
	.recent-columns :global(.experience-label) {
		font-size: var(--text-xs);
		color: var(--term-gray-58);
	}

	.recent-columns :global(.experience-label) {
		margin-bottom: 0;
	}

	/* headline: same size/weight/color in both columns */
	.recent-columns :global(.activity-title),
	.recent-columns :global(.experience-title h3) {
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--fg);
	}

	.recent-columns :global(.experience-company) {
		font-size: var(--text-xs);
	}

	/* secondary/body text: same size, muted, in both columns */
	.recent-columns :global(.activity-commit),
	.recent-columns :global(.commit-entry) {
		font-size: var(--text-xs);
	}

	.recent-columns :global(.experience-content .text-muted) {
		font-size: var(--text-xs);
	}

	.recent-columns :global(.clamp-toggle) {
		font-size: var(--text-xs);
		color: var(--term-gray-72);
	}

	/* vertical rhythm: identical gap between entries in both columns */
	.recent-columns :global(.activity-event) {
		margin-bottom: var(--space-md);
	}

	.recent-columns :global(.experience-content) {
		padding-bottom: var(--space-md);
	}

	/* font-mono: Timeline is already mono; Experience needs it explicitly on home */
	.recent-columns :global(.experience-timeline),
	.recent-columns :global(.experience-legend) {
		font-family: var(--font-mono);
	}

	@media (min-width: 1024px) {
		.recent-columns {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}
	}

	@media (max-width: 640px) {
		.home-sections {
			gap: var(--space-lg);
			padding-block: var(--space-md);
		}

		.hero-name {
			font-size: var(--text-3xl);
		}

		.hero-tagline {
			font-size: var(--text-base);
		}
	}
</style>

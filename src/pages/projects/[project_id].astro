---
import ProjectPage from '../../components/projects/ProjectPage.astro'
import Page from '../../layouts/Page.astro'
import { get_project, type AppLocals } from '../../utils'
const { project_id } = Astro.params

// fetch the project from api
const project = project_id ? await get_project(Astro.locals as AppLocals, project_id) : null

const description = project?.description ?? (project?.name ? `Project page for ${project.name}` : `Invalid project`)
const ogImage = `https://forbit.dev/og/project/${project_id}.png`
---

<Page title={project?.name ?? '404'} description={description} canonical={`https://forbit.dev/projects/${project_id}`} ogImage={ogImage}>
    <div class="stack" style="overflow-x: hidden;">
        {project ? <ProjectPage project={project} /> : <p class="text-muted" style="text-align: center;">Invalid Project!</p>}
    </div>
</Page>

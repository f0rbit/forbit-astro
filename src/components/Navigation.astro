---
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import { Github, Twitter, Mail } from "lucide-astro";
import { PATH_TABS, is_active_path } from "../lib/path-nav";

interface Props {
	// kept for backward compatibility with existing call sites; active-tab
	// detection is derived from the URL, not this prop.
	home?: boolean | null;
}

const pathname = Astro.url.pathname;
---

<Astronav>
	<nav class="path-nav row row-sm" aria-label="Primary">
		{
			PATH_TABS.map((tab) => (
				<a href={tab.href} class:list={["path-tab", { "path-tab--active": is_active_path(tab.href, pathname) }]}>
					{tab.label}
				</a>
			))
		}
	</nav>
	<div class="mobile-menu">
		<div class="menu-icon">
			<MenuIcon class="menu-icon-size" />
		</div>
		<MenuItems class="path-menu hidden">
			<div class="path-menu-inner stack">
				<p class="path-menu-heading font-mono text-accent">$ cd ~/</p>
				<div class="stack stack-sm path-menu-rows">
					{
						PATH_TABS.map((tab) => (
							<a href={tab.href} class:list={["path-menu-row font-mono", { "path-tab--active": is_active_path(tab.href, pathname) }]}>
								{"→ "}
								{tab.label}
							</a>
						))
					}
				</div>
				<div class="row row-sm path-menu-socials">
					<a href="https://github.com/f0rbit" aria-label="GitHub"><Github size={18} /></a>
					<a href="https://twitter.com/f0rbit" aria-label="Twitter"><Twitter size={18} /></a>
					<a href="mailto:dev@forbit.dev" aria-label="Email"><Mail size={18} /></a>
				</div>
			</div>
		</MenuItems>
	</div>
</Astronav>

<style>
	.path-nav {
		display: none;
	}

	.path-tab {
		color: var(--fg-faint);
		text-decoration: none;
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		filter: none;
		transition: color var(--transition);
	}
	.path-tab:hover {
		color: var(--fg-muted);
		filter: none;
	}
	.path-tab--active {
		color: var(--term-link);
	}

	.mobile-menu {
		position: relative;
	}
	.menu-icon {
		/* Stacked above `.path-menu` (z-index 20, a descendant of the same
		   `.terminal-titlebar` stacking context) so the toggle button — which
		   swaps to the × glyph — stays visible and clickable while the
		   full-screen menu is open. */
		position: relative;
		z-index: 21;
		display: flex;
		align-items: center;
	}
	.menu-icon-size {
		width: 1.25rem;
		height: 1.25rem;
		color: var(--fg-muted);
	}
	/* the close (×) glyph is the same button, swapped in by astro-navbar's script */
	:global(.astronav-close-icon) {
		fill: var(--term-link);
	}

	/*
	 * astro-navbar toggles the shared `.hidden` utility on click (see
	 * astro-navbar's Astronav script) — these two rules are unlayered so they
	 * outrank @f0rbit/ui's layered `.hidden { display: none }` utility either way,
	 * and `.path-menu.hidden` (2 classes) outranks plain `.path-menu` (1 class)
	 * so the closed state always wins until the class is removed on toggle.
	 *
	 * `position: fixed; inset: 0` makes this a true full-screen overlay (per
	 * the mobile sketch) rather than being scoped to `.mobile-menu`'s own box
	 * (which is just the hamburger button's hit area) — an absolutely
	 * positioned menu would otherwise inherit that tiny container as its
	 * containing block and render as a sliver. `.terminal-titlebar` carries a
	 * higher z-index (see TerminalWindow.astro) so the titlebar — including
	 * this same toggle button, now showing the × — stays visible above the
	 * overlay, matching the sketch's "titlebar stays, body becomes the menu".
	 */
	:global(.path-menu) {
		display: block;
		position: fixed;
		inset: 0;
		z-index: 20;
		background: var(--term-panel);
		overflow-y: auto;
	}
	:global(.path-menu.hidden) {
		display: none;
	}
	.path-menu-inner {
		/* Top padding clears the titlebar (which paints above this overlay,
		   see TerminalWindow.astro's z-index) plus the page shell's own top
		   padding — both are small, roughly-constant chrome heights, so a
		   fixed multiple of --space-lg is enough clearance without needing
		   exact measurement. */
		padding: calc(var(--space-lg) * 3) var(--space-lg) var(--space-lg);
	}
	.path-menu-heading {
		margin: 0;
	}
	.path-menu-row {
		color: var(--fg-muted);
		text-decoration: none;
		filter: none;
	}
	.path-menu-row.path-tab--active {
		color: var(--term-link);
	}
	.path-menu-socials a {
		color: var(--fg-muted);
	}
	.path-menu-socials a:hover {
		color: var(--term-link);
	}

	@media (min-width: 1024px) {
		.path-nav {
			display: flex;
		}
		.mobile-menu {
			display: none;
		}
	}
</style>

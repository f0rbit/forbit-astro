---
import { Collapsible } from '@f0rbit/ui'
import { fetch_timeline, get_timeline, type AppLocals } from '../../utils'
import { format_relative_time } from '../../lib/time'
import CommitList from './CommitList.astro'
interface Props {
    limit: number | null
    group_commits: boolean
    project_repo?: string
}

const { limit, group_commits, project_repo = null } = Astro.props

const activity = await fetch_timeline(Astro.locals as AppLocals)

let events = get_timeline(activity, group_commits)

// oxlint-disable-next-line typescript/no-explicit-any -- events come from get_timeline(), untyped pending its own @todo in utils.ts
if (project_repo) events = events.filter((event: any) => event.permalink && event.permalink.includes(project_repo))

// limit the response
if (limit) events = events.slice(0, limit)
---

<div class="activity-timeline font-mono">
    <div class="activity-timeline-line"></div>
    <div class="stack stack-sm activity-timeline-events">
        {
            events.map((event: any) => {
                return (
                    <div class="activity-event">
                        <div class="activity-dot" />
                        <div class="activity-content row row-sm">
                            <span class="text-xs activity-time">{format_relative_time(new Date(event.date))}</span>
                            <span class="text-sm activity-title">{event.title ?? ''}</span>
                        </div>
                        <div class="activity-detail">
                            {event.category == 'GITHUB' && (
                                <p class="text-sm activity-commit">
                                    <a href={event.permalink} class="font-mono activity-hash">
                                        {event.sha.slice(0, 7)}
                                    </a>{' '}
                                    <span class="activity-repo">forbit/{event.project}</span>
                                </p>
                            )}
                            {event.category == 'COMMITS' &&
                                (event.commits?.length > 5 ? (
                                    <Collapsible client:visible trigger={`${event.commits.length} commits`}>
                                        <CommitList commits={event.commits} />
                                    </Collapsible>
                                ) : (
                                    <CommitList commits={event.commits} />
                                ))}
                        </div>
                    </div>
                )
            })
        }
    </div>
</div>

<style>
    .activity-timeline {
        position: relative;
        padding-left: 2.5rem;
    }
    .activity-timeline-line {
        position: absolute;
        left: 1.25rem;
        top: 0.75rem;
        bottom: 0;
        width: 1px;
        background: var(--term-border-inner);
    }
    .activity-timeline-events {
        max-width: min(100%, 90vw);
        width: min(85vw, 35rem);
    }
    .activity-dot {
        position: absolute;
        left: calc(-1.25rem - 8px);
        top: calc(0.375rem - 4px);
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: var(--term-gray-58);
        border: 4px solid var(--term-panel);
    }
    .activity-event {
        position: relative;
        margin-bottom: var(--space-sm);
    }
    .activity-detail {
        padding-left: 1.25rem;
    }
    .activity-content {
        align-items: baseline;
        flex-wrap: wrap;
    }
    .activity-time {
        color: var(--term-gray-58);
        white-space: nowrap;
    }
    .activity-title {
        color: var(--fg);
        font-weight: 600;
    }
    .activity-hash {
        color: var(--term-gray-85);
    }
    .activity-repo {
        color: var(--term-gray-72);
        font-style: italic;
    }
</style>

---
import type { Experience } from "../../assets/experience";
import { format_duration } from "../../utils";
import { format_calendar } from "../../lib/time";
import SkillEvents from "../about/SkillEvents.astro";
import AwardTypeIcon from "../projects/AwardTypeIcon.astro";
import { Badge, Clamp } from "@f0rbit/ui";

interface Props {
	experience: Experience & { id: string };
	isLast?: boolean;
}

const { experience, isLast = false } = Astro.props;

const end_date = experience.end_date ?? new Date();
const date_string = `${format_calendar(experience.start_date)} - ${experience.end_date ? format_calendar(experience.end_date) : "Present"}`;
const duration = format_duration(experience.start_date, end_date);
const { title, company, awards, type } = experience;
---

<div class="experience-row">
	<div class="experience-indicator">
		<span class:list={["experience-dot", `experience-dot--${type}`]} />
		{!isLast && <span class="experience-connector" />}
	</div>
	<div class="experience-content stack stack-sm">
		<label class="text-sm text-subtle experience-label">
			<span>{date_string}</span>
			{duration && <span> ({duration})</span>}
		</label>
		<div class="experience-title">
			<h3 id={experience.id}>{title}</h3>
			{company && <span class:list={["experience-company", `experience-company--${type}`]}>{company}</span>}
		</div>
		<div class="stack stack-sm">
			<Clamp client:load lines={2} showMoreText="Read More" showLessText="Read Less">
				<p class="text-muted">{experience.description}</p>
			</Clamp>
			<div class="cluster experience-awards">
				{
					awards.map((award) => (
						<Badge title={award.description}>
							<AwardTypeIcon type={award.type} size={20} />
							<span>{award.title}</span>
						</Badge>
					))
				}
				{experience.skills.map((event) => <SkillEvents event={event} />)}
			</div>
		</div>
	</div>
</div>

<style>
	.experience-row {
		display: flex;
		gap: var(--space-sm);
	}
	.experience-indicator {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 20px;
		flex-shrink: 0;
		padding-top: 6px;
	}
	.experience-dot {
		width: 11px;
		height: 11px;
		border-radius: 50%;
		flex-shrink: 0;
	}
	.experience-dot--professional {
		background: var(--term-gray-85);
	}
	.experience-dot--hobby {
		background: var(--term-gray-72);
	}
	.experience-dot--learning {
		background: var(--term-link);
	}
	.experience-connector {
		width: 1px;
		flex-grow: 1;
		background: var(--term-border-inner);
		margin-top: 4px;
	}
	.experience-content {
		flex: 1;
		min-width: 0;
		padding-bottom: var(--space-lg);
	}
	.experience-label {
		margin-bottom: -0.25rem;
	}
	.experience-title {
		display: flex;
		flex-direction: row;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.6rem;
	}
	.experience-company {
		font-size: 0.82rem;
		font-style: italic;
	}
	.experience-company--professional {
		color: var(--term-gray-85);
	}
	.experience-company--hobby {
		color: var(--term-gray-72);
	}
	.experience-company--learning {
		color: var(--term-link);
	}
	.experience-awards {
		align-items: center;
	}
</style>

---
import { Copyright, Linkedin, Twitter, Mail } from "lucide-astro";
---

<footer>
    <div class="page-container">
        <div class="footer-content row row-between">
            <section class="row row-sm text-sm text-subtle footer-icons">
                <Copyright size={18} />
                <p>All Rights Reserved</p>
            </section>
            <section class="row row-sm footer-icons">
                <a href="https://twitter.com/f0rbit"><Twitter size={18} /></a>
                <a href="https://www.linkedin.com/in/tom-materne-001"><Linkedin size={18} /></a>
                <a href="mailto:dev@forbit.dev"><Mail size={18} /></a>
            </section>
        </div>
    </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
  }
  .footer-content {
    padding-block: var(--space-sm);
  }
</style>

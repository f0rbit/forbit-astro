---
import type { PROJECT_STATUS } from '../../types'

interface Props {
    status: PROJECT_STATUS,
    size?: number
}

const { status } = Astro.props
const size = Astro.props.size ?? 13;

interface StatusVisual {
    label: string
    glyph: string
    color: string
}

function get_visual(project_status: PROJECT_STATUS): StatusVisual {
    switch (project_status) {
        case 'DEVELOPMENT':
            return { label: 'dev', glyph: '●', color: 'var(--term-status-dev)' }
        case 'PAUSED':
            return { label: 'paused', glyph: '●', color: 'var(--term-gray-58)' }
        case 'LIVE':
        case 'FINISHED':
            return { label: 'finished', glyph: '✓', color: 'var(--term-status-finished)' }
        case 'RELEASED':
            return { label: 'released', glyph: '↑', color: 'var(--term-gray-72)' }
        case 'STOPPED':
        case 'ABANDONED':
            return { label: project_status.toLowerCase(), glyph: '✕', color: 'var(--fg-faint)' }
    }
}

const visual = get_visual(status)
---

<span class="status-pill font-mono" style={`--status-color: ${visual.color}; font-size: ${size}px;`}>
    <span aria-hidden="true">{visual.glyph}</span>
    <span>{visual.label}</span>
</span>

<style>
    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.35em;
        color: var(--status-color);
        border: 1px solid var(--status-color);
        border-radius: 999px;
        padding: 0.15em 0.65em;
        line-height: 1;
        white-space: nowrap;
    }
</style>

---
import { remark } from 'remark'
import { TECH_MAP, type Technology } from '../../assets/technology'
import type { Project } from '../../types'
import remarkHtml from 'remark-html'
import Status from './Status.astro'
import { ArrowLeft, ExternalLink, Github } from 'lucide-astro'
import PublishTime from '../blog/PublishTime'
import Timeline from '../activity/Timeline.astro'

interface Props {
    project: Project
}

const { project } = Astro.props

const technologies: Technology[] = TECH_MAP[project.project_id] ?? []

const parsed = project.specification ? await remark().use(remarkHtml).process(project.specification) : null
---

<a class="back-link row row-sm text-sm text-muted" href="/projects">
    <ArrowLeft size={15} />
    <span>cd ..</span>
</a>

<header class="row row-between project-header">
    <div>
        <p class="text-sm text-muted project-breadcrumb">~/work/<span class="text-primary">{project.name}</span></p>
        <div class="row project-heading">
            <h1>{project.name}</h1>
            <Status status={project.status} size={13} />
        </div>
        <p class="project-description">{project.description}</p>
    </div>
    {
        (project.repo_url || project.link_url) && (
            <div class="stack stack-sm project-actions">
                {
                    project.repo_url && (
                        <a class="lift project-action" href={project.repo_url}>
                            <Github size={16} />
                            <span>GitHub</span>
                        </a>
                    )
                }
                {
                    project.link_url && (
                        <a class="lift project-action project-action--primary" href={project.link_url}>
                            <ExternalLink size={16} />
                            <span>{project.link_text ?? 'Live'}</span>
                        </a>
                    )
                }
            </div>
        )
    }
</header>

<div class="project-body">
    <article class="project-article">
        <p class="text-sm text-muted project-readme-prompt">$ cat README.md</p>
        <h2 class="project-section-heading">Overview</h2>
        <p>{project.description}</p>
        {
            project.specification ? (
                <article class="specification">{parsed}</article>
            ) : null
        }
    </article>

    <aside class="stack project-sidebar">
        <div class="sidebar-box">
            <p class="text-xs text-muted sidebar-heading"># metadata</p>
            <dl class="sidebar-meta">
                <div class="row row-between">
                    <dt class="text-muted">status</dt>
                    <dd><Status status={project.status} size={13} /></dd>
                </div>
                {
                    project.current_version && (
                        <div class="row row-between">
                            <dt class="text-muted">version</dt>
                            <dd class="text-primary">{project.current_version}</dd>
                        </div>
                    )
                }
                {
                    project.updated_at && (
                        <div class="row row-between">
                            <dt class="text-muted">last updated</dt>
                            {/* sidebar metadata, below the fold on first paint — defer hydration until visible */}
                            <dd class="text-primary"><PublishTime client:visible date={project.updated_at} /></dd>
                        </div>
                    )
                }
            </dl>
        </div>

        {
            technologies.length > 0 && (
                <div>
                    <p class="text-xs text-muted sidebar-heading"># stack</p>
                    <div class="cluster sidebar-tags">
                        {technologies.map((tech) => <span class="tag">{tech}</span>)}
                    </div>
                </div>
            )
        }

        {
            project.repo_url && (
                <div class="sidebar-commits">
                    <p class="text-xs text-muted sidebar-heading"># recent commits</p>
                    <Timeline project_repo={project.repo_url} limit={10} group_commits={false} />
                </div>
            )
        }
    </aside>
</div>

<style>
    .back-link {
        margin-bottom: var(--space-md);
        width: fit-content;
    }
    .project-header {
        align-items: flex-start;
        gap: var(--space-xl);
        padding-bottom: var(--space-md);
        border-bottom: 1px solid var(--term-border-inner);
        margin-bottom: var(--space-lg);
    }
    .project-breadcrumb {
        overflow-wrap: anywhere;
    }
    .project-heading {
        align-items: center;
        gap: var(--space-sm);
        margin-top: var(--space-xs);
    }
    .project-heading h1 {
        font-size: var(--text-4xl);
        font-weight: 700;
        letter-spacing: -0.02em;
    }
    .project-description {
        color: var(--fg-muted);
        margin-top: var(--space-sm);
        max-width: 60ch;
    }
    .project-actions {
        flex-shrink: 0;
    }
    .project-sidebar {
        min-width: 0;
    }
    .project-action {
        display: inline-flex;
        align-items: center;
        gap: var(--space-xs);
        font-size: var(--text-sm);
        border: 1px solid var(--term-border-inner);
        border-radius: var(--radius);
        padding: var(--space-xs) var(--space-md);
        background: var(--term-titlebar);
        color: var(--fg);
    }
    .project-action--primary {
        background: var(--term-gray-72);
        border-color: var(--term-gray-72);
        color: var(--bg);
    }
    .project-body {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: var(--space-xl);
        align-items: start;
    }
    @media (min-width: 1024px) {
        .project-body {
            grid-template-columns: minmax(0, 1fr) 280px;
        }
    }
    .project-article {
        min-width: 0;
        overflow-wrap: anywhere;
    }
    .project-readme-prompt {
        margin-bottom: var(--space-md);
    }
    .project-section-heading {
        font-size: var(--text-xl);
        font-weight: 700;
    }
    .specification {
        margin-top: var(--space-md);
        color: var(--fg-subtle);
        line-height: 1.7;
    }
    .specification :global(h1),
    .specification :global(h2),
    .specification :global(h3) {
        color: var(--fg);
        font-weight: 700;
        margin: var(--space-md) 0 var(--space-sm);
    }
    .specification :global(pre) {
        background: var(--bg);
        border: 1px solid var(--term-border-inner);
        border-radius: var(--radius);
        padding: var(--space-md);
        overflow-x: auto;
        font-size: var(--text-sm);
    }
    .specification :global(code) {
        font-family: var(--font-mono);
    }
    .specification :global(a) {
        color: var(--term-link);
    }
    .specification :global(blockquote) {
        border-left: 3px solid var(--term-gray-72);
        padding-left: var(--space-md);
        color: var(--fg-muted);
        font-style: italic;
    }
    .sidebar-box {
        border: 1px solid var(--term-border-inner);
        border-radius: var(--radius);
        background: var(--term-titlebar);
        padding: var(--space-md);
    }
    .sidebar-heading {
        margin-bottom: var(--space-sm);
    }
    .sidebar-meta {
        display: flex;
        flex-direction: column;
        gap: var(--space-sm);
        font-size: var(--text-sm);
    }
    .sidebar-meta dt,
    .sidebar-meta dd {
        margin: 0;
    }
    .sidebar-tags {
        gap: var(--space-xs);
    }
    .tag {
        font-size: var(--text-xs);
        color: var(--fg-muted);
        border: 1px solid var(--term-border-inner);
        border-radius: var(--radius);
        padding: 0.2rem 0.5rem;
    }
    .sidebar-commits :global(*) {
        font-size: var(--text-sm);
    }
</style>

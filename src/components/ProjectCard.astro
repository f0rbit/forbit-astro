---
import { ExternalLink, FolderGit2, Github } from 'lucide-astro'
import type { Project } from '../types'
import Status from './projects/Status.astro'
import { TECH_MAP, type Technology } from '../assets/technology'

interface Props {
    project: Project
}

const { project } = Astro.props

const technologies: Technology[] = TECH_MAP[project.project_id] ?? []
---

<a class="project-card lift" href={`/projects/${project.project_id}`}>
    <div class="row row-between">
        <span class="row row-sm text-sm text-muted project-card-path">
            <FolderGit2 size={16} />
            <span>~/work/<span class="text-primary project-card-name">{project.name}</span></span>
        </span>
        <Status status={project.status} />
    </div>
    <p class="text-sm text-muted project-card-description">{project.description}</p>
    <div class="row row-between">
        <div class="row row-sm text-xs project-card-tags">
            {technologies.map((tech) => <span>{tech}</span>)}
        </div>
        <div class="row row-sm text-muted project-card-links">
            {project.repo_url && <Github size={15} aria-label="GitHub repository" />}
            {project.link_url && <ExternalLink size={15} aria-label={project.link_text ?? 'Live link'} />}
        </div>
    </div>
</a>

<style>
    .project-card {
        display: flex;
        flex-direction: column;
        gap: var(--space-sm);
        height: 100%;
        padding: var(--space-md);
        border: 1px solid var(--term-border-inner);
        border-radius: var(--radius);
        background: var(--term-titlebar);
        cursor: pointer;
    }
    .project-card-path {
        min-width: 0;
    }
    .project-card-name {
        font-weight: 600;
    }
    .project-card-description {
        flex-grow: 1;
        line-height: 1.5;
    }
    .project-card-tags {
        flex-wrap: wrap;
    }
</style>
